# PostgreSQL
POSTGRES_DB=benzine
POSTGRES_USER=benzine
POSTGRES_PASSWORD=change-me

# JWT (genereer met: openssl rand -base64 48)
JWT_KEY=change-me-to-a-long-random-string-min-32-chars

# Angular-frontend origin (voor CORS)
FRONTEND_ORIGIN=http://localhost:4200

# SMTP voor wachtwoord-resetmails
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_SSL=true
EMAIL_USERNAME=gebruikersnaam
EMAIL_PASSWORD=change-me
EMAIL_FROM=no-reply@example.com
EMAIL_FRONTEND_URL=http://localhost:4200

ASPNETCORE_ENVIRONMENT=Production
